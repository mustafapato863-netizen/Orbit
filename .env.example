# PostgreSQL password must be supplied manually in the local .env file.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/project_management?schema=public"

# Optional and reserved for future signed integrations. Current sessions are opaque database tokens.
AUTH_SECRET="REPLACE_WITH_A_SECURE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS"

# Optional. Set manually before seeding local development login accounts.
SEED_LOCAL_PASSWORD=""

NEXT_PUBLIC_APP_NAME="Orbit Project Manager"
APP_URL="http://localhost:3000"
